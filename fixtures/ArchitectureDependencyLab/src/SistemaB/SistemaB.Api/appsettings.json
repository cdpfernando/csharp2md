{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Primary": "Data Source=synthetic_data.db",
    "Secondary": "Data Source=synthetic_data.db"
  },
  "Cache": {
    "Endpoint": "localhost:6379",
    "Credential": "NOT_A_REAL_SECRET_ROTATE_ME"
  },
  "Authentication": {
    "Authority": "https://auth.synthetic.local",
    "TokenEndpoint": "https://auth.synthetic.local/oauth/token",
    "ClientId": "client_sistema_b",
    "ClientSecret": "NOT_A_REAL_SECRET_ROTATE_ME"
  },
  "Environment": {
    "Name": "Production"
  },
  "Services": {
    "Price": {
      "BaseUrl": "http://localhost:5101"
    },
    "Catalog": {
      "BaseUrl": "http://localhost:5102"
    },
    "Risk": {
      "BaseUrl": "http://localhost:5103"
    },
    "Calculation": {
      "BaseUrl": "http://localhost:5105"
    },
    "Formalization": {
      "BaseUrl": "http://localhost:5106"
    }
  },
  "Messaging": {
    "Brokers": "localhost:9092",
    "SchemaRegistryUrl": "http://localhost:8081",
    "Topic": "pedidos-topic",
    "ClientPassword": "NOT_A_REAL_SECRET_ROTATE_ME"
  },
  "Certificates": {
    "Path": "/certs/synthetic.pfx",
    "Password": "NOT_A_REAL_SECRET_ROTATE_ME"
  },
  "Resilience": {
    "SyncTimeout": "00:00:05",
    "AsyncTimeout": "00:00:30",
    "ValidationTimeout": "00:00:02"
  },
  "Telemetry": {
    "TraceExporter": "Otlp",
    "MetricsEnabled": true,
    "LogLevel": "Information"
  },
  "Authorization": {
    "AllowedProfiles": [ "Admin", "Analista", "Operador" ]
  }
}
