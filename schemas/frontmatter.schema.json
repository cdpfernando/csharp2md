{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/csharp2md/csharp2md/schemas/frontmatter.schema.json",
  "title": "csharp2md LLMWiki frontmatter",
  "description": "Published contract for the YAML frontmatter block csharp2md prepends to every generated Markdown document (spec.md's Frontmatter Schema section is the normative field table). Not executed at runtime by csharp2md itself — the runtime check is a YAML round-trip plus required-field validation over the closed Frontmatter record; a test keeps this file in sync with that record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "source_kind",
    "source_path",
    "domain",
    "topic",
    "language",
    "file_type",
    "tags",
    "created_by",
    "source_service",
    "analysis_status"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Resolved per the four-tier title rule."
    },
    "source_kind": {
      "type": "string",
      "enum": ["codebase-file", "codebase-index"]
    },
    "source_path": {
      "type": "string",
      "description": "<service-name>/<service-relative-path>, forward-slash separated, trailing .md removed."
    },
    "domain": {
      "type": "string",
      "description": "Verbatim value of --domain."
    },
    "topic": {
      "type": "string",
      "description": "Verbatim value of --topic."
    },
    "language": {
      "type": "string",
      "const": "csharp"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "configuration",
        "controller",
        "handler",
        "service",
        "data-access",
        "enum",
        "interface",
        "filter",
        "extension",
        "class",
        "index"
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_by": {
      "type": "string",
      "const": "csharp2md"
    },
    "source_service": {
      "type": ["string", "null"],
      "description": "Always null in Phase 1; Phase 2 resolves service ownership."
    },
    "analysis_status": {
      "type": "string",
      "const": "pending",
      "description": "Always \"pending\" in Phase 1."
    }
  }
}
